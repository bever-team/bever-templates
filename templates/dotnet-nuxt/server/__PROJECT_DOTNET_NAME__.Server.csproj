<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>__PROJECT_DOTNET_NAME__.Server</RootNamespace>
    <!-- wwwroot holds the client built by "npm run generate"; serve it as plain files. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bever.AspNetCore" Version="__BEVER_VERSION__" />
  </ItemGroup>

</Project>
